{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HébergTonServ Desktop Preview",
  "version": "0.4.39-rc.3",
  "identifier": "com.hebergtonserv.desktop.preview",
  "mainBinaryName": "hebergtonserv-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HébergTonServ Desktop Preview",
        "windowClassname": "Tools.fxmp.org",
        "width": 520,
        "height": 360,
        "minWidth": 520,
        "minHeight": 360,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#0f172a",
        "userAgent": "hebergtonserv.desktop.preview/0.4.39-rc.3",
        "devtools": true,
        "browserExtensionsEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src blob:; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRjRBMThDODc0QkZFREIKUldUYi9rdUhqS0gwc1o1RG1lWHAvYkc2aFdwODZmVkhta0RNaUxXdUNzVVRMcjQ5eVFvdW9peVkK",
      "endpoints": [
        "https://github.com/Mesrine67/hebergtonserv-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "publisher": "HebergTonServ",
    "category": "DeveloperTool",
    "shortDescription": "HébergTonServ Desktop — gestion des clés SSH, connexions et panels d'hébergement",
    "longDescription": "HébergTonServ Desktop est une application de gestion des clés SSH, des connexions et des panels d'hébergement. Elle permet aux utilisateurs de gérer facilement leurs serveurs et services d'hébergement à partir d'une interface conviviale.",
    "copyright": "Copyright © 2026 HebergTonServ. All rights reserved.",
    "createUpdaterArtifacts": false,
    "active": true,
    "targets": "all",
    "resources": [
      "../docs/**/*.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
